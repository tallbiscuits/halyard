+<script lang="ts">
+import { Component, Mixins, Watch } from 'vue-property-decorator'
+import BaseMixin from '@/components/mixins/base'
+import GcodefilesMixin from '@/components/mixins/gcodefiles'
+import Panel from '@/components/ui/Panel.vue'
+import ConfirmationDialog from '@/components/dialogs/ConfirmationDialog.vue'
+import GcodefilesThumbnail from '@/components/panels/Gcodefiles/GcodefilesThumbnail.vue'
+import GcodefilesPanelTableRowFileMetadata from '@/components/panels/Gcodefiles/GcodefilesPanelTableRowFileMetadata.vue'
+import GcodefilesPanelTableRowFileMetadataFilaments from '@/components/panels/Gcodefiles/GcodefilesPanelTableRowFileMetadataFilaments.vue'
+import GcodefilesPanelTableRowFileMetadataFilamentStrings from '@/components/panels/Gcodefiles/GcodefilesPanelTableRowFileMetadataFilamentStrings.vue'
+import GcodefilesPanelTableRowFileMetadataSlicer from '@/components/panels/Gcodefiles/GcodefilesPanelTableRowFileMetadataSlicer.vue'
+import { FileStateGcodefile } from '@/store/files/types'
+import type { PrinterCardFile, PrinterCardListing } from '@/types/moonraker/HalyardRPC'
+import { mdiAlertOutline, mdiDelete, mdiLockOutline, mdiPlay, mdiPrinter3d, mdiRefresh, mdiSd } from '@mdi/js'
+
+// Halyard: the printer's own SD card, where Halyard copies each file before the printer
+// prints it. Halyard lists it (M20) only while the printer is idle; during a print this shows
+// the last listing. Printing a file here starts it as it is on the card, with nothing copied.
+// The columns are G-Code Files' own (its settings choose and order them). The printer can't
+// send a file back, so a file's metadata is known only for a copy Halyard wrote from its
+// library; other files show "--".
+@Component({
+    components: {
+        ConfirmationDialog,
+        GcodefilesPanelTableRowFileMetadata,
+        GcodefilesPanelTableRowFileMetadataFilaments,
+        GcodefilesPanelTableRowFileMetadataFilamentStrings,
+        GcodefilesPanelTableRowFileMetadataSlicer,
+        GcodefilesThumbnail,
+        Panel,
+    },
+})
+export default class PrinterCardPanel extends Mixins(BaseMixin, GcodefilesMixin) {
+    mdiAlertOutline = mdiAlertOutline
+    mdiDelete = mdiDelete
+    mdiLockOutline = mdiLockOutline
+    mdiPlay = mdiPlay
+    mdiPrinter3d = mdiPrinter3d
+    mdiRefresh = mdiRefresh
+    mdiSd = mdiSd
+
+    listing: PrinterCardListing = { files: [], listed: false, version: 0 }
+    loading = false
+    selected = ''
+    selectedNames: string[] = []
+    showPrintDialog = false
+    showDeleteDialog = false
+    showDeleteSelectedDialog = false
+
+    get isHalyard() {
+        return 'halyard' in this.$store.state.printer
+    }
+
+    get cardVersion(): number | null {
+        return this.$store.state.printer.halyard?.card_version ?? null
+    }
+
+    get handoffActive() {
+        return (this.$store.state.printer.halyard?.handoff?.state ?? 'idle') !== 'idle'
+    }
+
+    get canAct() {
+        return this.klipperReadyForGui && !this.handoffActive && !['printing', 'paused'].includes(this.printer_state)
+    }
+
+    // Each file as G-Code Files' cells and thumbnail take it: the card's name, size and date,
+    // and the metadata of the library file it was copied from. The thumbnails' paths are
+    // relative to that file, so full_filename is the library's name.
+    get rows(): { file: PrinterCardFile; item: FileStateGcodefile }[] {
+        return this.listing.files.map((file) => ({
+            file,
+            item: {
+                ...(file.metadata ?? {}),
+                filename: file.name,
+                full_filename: file.library ?? file.name,
+                isDirectory: false,
+                modified: file.modified ? new Date(file.modified.replace(' ', 'T')) : null,
+                permissions: 'rw',
+                size: file.size,
+                preheat_gcode: null,
+                count_printed: 0,
+                last_end_time: null,
+                last_filament_used: null,
+                last_print_duration: null,
+                last_status: null,
+                last_start_time: null,
+                last_total_duration: null,
+            } as FileStateGcodefile,
+        }))
+    }
+
+    // What can be selected: the printer can't open a locked file (Halyard says why).
+    get selectable() {
+        return this.listing.files.filter((file) => !file.locked).map((file) => file.name)
+    }
+
+    get allSelected() {
+        return this.selectable.length > 0 && this.selectedNames.length === this.selectable.length
+    }
+
+    get notice() {
+        if (this.listing.error) return this.listing.error
+        if (this.listing.stale && this.listing.listed)
+            return this.$t('Panels.PrinterCardPanel.Stale', { reason: this.listing.stale })
+        if (this.listing.stale) return this.$t('Panels.PrinterCardPanel.NotListed', { reason: this.listing.stale })
+
+        return null
+    }
+
+    async load(refresh: boolean) {
+        if (!this.klipperReadyForGui) return
+
+        this.loading = true
+        try {
+            this.listing = await this.$socket.emitAndWait('printer.card.list', { refresh })
+        } finally {
+            this.loading = false
+        }
+    }
+
+    refresh() {
+        this.load(true)
+    }
+
+    toggle(name: string) {
+        if (this.selectedNames.includes(name)) this.selectedNames = this.selectedNames.filter((n) => n !== name)
+        else this.selectedNames = [...this.selectedNames, name]
+    }
+
+    selectAll(all: boolean) {
+        this.selectedNames = all ? [...this.selectable] : []
+    }
+
+    askPrint(file: PrinterCardFile) {
+        this.selected = file.name
+        this.showPrintDialog = true
+    }
+
+    askDelete(file: PrinterCardFile) {
+        this.selected = file.name
+        this.showDeleteDialog = true
+    }
+
+    askDeleteSelected() {
+        this.showDeleteSelectedDialog = true
+    }
+
+    // Refusals come back as "!!" console lines, which Mainsail shows as messages here.
+    print() {
+        this.$socket.emit('printer.card.print', { name: this.selected })
+    }
+
+    remove() {
+        this.$socket.emit('printer.card.delete', { name: this.selected })
+    }
+
+    // One M30 after another; a refusal (the printer started printing, say) stops the rest.
+    async removeSelected() {
+        const names = [...this.selectedNames]
+        this.selectedNames = []
+        for (const name of names) {
+            try {
+                await this.$socket.emitAndWait('printer.card.delete', { name })
+            } catch {
+                break
+            }
+        }
+    }
+
+    mounted() {
+        this.load(true)
+    }
+
+    // A new listing (after a copy, a delete or a reconnect): fetch it as Halyard has it.
+    @Watch('cardVersion')
+    cardVersionChanged(newVal: number | null) {
+        if (newVal !== null && newVal !== this.listing.version) this.load(false)
+    }
+
+    // A selection keeps only the files the card still holds.
+    @Watch('listing')
+    listingChanged() {
+        this.selectedNames = this.selectedNames.filter((name) => this.selectable.includes(name))
+    }
+
+    // A print starts or ends: the same listing, now marked stale or no longer.
+    @Watch('printer_state')
+    printerStateChanged(newVal: string, oldVal: string) {
+        const printing = (state: string) => ['printing', 'paused'].includes(state)
+        if (printing(newVal) !== printing(oldVal)) this.load(false)
+    }
+
+    @Watch('klipperReadyForGui')
+    klipperReadyForGuiChanged(newVal: boolean) {
+        if (newVal) this.load(false)
+    }
+}
+</script>
+
+<style scoped>
+.printer-card-panel__table td {
+    vertical-align: middle;
+}
+
+.file-list__select-td {
+    width: 24px;
+}
+</style>
