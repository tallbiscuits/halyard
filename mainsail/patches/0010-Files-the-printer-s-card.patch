@@ -0,0 +1,59 @@
+/**
+ * Halyard RPC Interface
+ *
+ * Halyard's own methods, beside the Moonraker subset it serves: the printer's own SD card,
+ * which Halyard lists with M20 while the printer is idle. Not part of Moonraker.
+ */
+
+import type { FileStateFile } from '@/store/files/types'
+
+/** A file on the printer's card, as M20 lists it */
+export interface PrinterCardFile {
+    /** The 8.3 path the printer knows it by */
+    name: string
+    size: number
+    /** With the printer's LONG_FILENAME_HOST_SUPPORT */
+    long_name?: string
+    /** With M20_TIMESTAMP_SUPPORT: "YYYY-MM-DD HH:MM", in the printer's local time */
+    modified?: string
+    /** The file in Halyard's library it was copied from */
+    library?: string
+    /** Whether the card still holds the copy Halyard wrote */
+    current?: boolean
+    /** The library file's metadata, as server.files.metadata has it, while the copy is current */
+    metadata?: Partial<FileStateFile>
+    /** The printer is printing it */
+    printing: boolean
+    /** Why the printer can't print or delete it over serial (a folder, on Marlin 2.1.2 and older) */
+    locked?: string
+}
+
+export interface PrinterCardListing {
+    files: PrinterCardFile[]
+    /** Listed at least once since the printer connected */
+    listed: boolean
+    listed_at?: number
+    /** Changes with every listing; the halyard printer object carries it too */
+    version: number
+    /** Why the last listing failed */
+    error?: string
+    /** Why this is the last listing and not a new one (the printer is printing) */
+    stale?: string
+}
+
+export interface HalyardRPC {
+    /**
+     * The printer's card: listed again unless refresh is false, or the last listing, with
+     * `stale` saying why, while the printer can't be asked.
+     */
+    'printer.card.list': (params: { refresh?: boolean }) => Promise<PrinterCardListing>
+
