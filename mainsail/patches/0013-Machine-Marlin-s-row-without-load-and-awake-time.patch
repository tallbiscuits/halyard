From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tallbiscuits <112773728+tallbiscuits@users.noreply.github.com>
Date: Sat, 10 Oct 2026 09:01:42 +0200
Subject: [PATCH 13/14] Machine: Marlin's row without load and awake time

Marlin reports neither, so the mcu object has no last_stats; the row shows its version and the machine's name only.

diff --git a/src/components/panels/Machine/SystemPanelMcu.vue b/src/components/panels/Machine/SystemPanelMcu.vue
index 07af71e..f649101 100644
--- a/src/components/panels/Machine/SystemPanelMcu.vue
+++ b/src/components/panels/Machine/SystemPanelMcu.vue
@@ -10,10 +10,11 @@
                         {{ $t('Machine.SystemPanel.Values.Version', { version: mcu.version }) }}
                     </div>
                     <div>
-                        <span class="text-no-wrap">
+                        <!-- Halyard: Marlin reports no load or awake time (no last_stats) -->
+                        <span v-if="mcu.last_stats" class="text-no-wrap">
                             {{ $t('Machine.SystemPanel.Values.Load', { load: mcu.load }) }},
                         </span>
-                        <span class="text-no-wrap">
+                        <span v-if="mcu.last_stats" class="text-no-wrap">
                             {{ $t('Machine.SystemPanel.Values.Awake', { awake: mcu.awake }) }},
                         </span>
                         <span v-if="mcu.freq !== null" class="text-no-wrap">
@@ -61,7 +62,7 @@
                     </div>
                 </div>
             </v-col>
-            <v-col class="px-2 col-auto d-flex justify-center align-center">
+            <v-col v-if="mcu.last_stats" class="px-2 col-auto d-flex justify-center align-center">
                 <v-progress-circular
                     :rotate="-90"
                     :size="55"
